<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical"
    android:padding="14dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/widget_cover" android:layout_width="48dp" android:layout_height="48dp"
            android:padding="12dp" android:src="@drawable/widget_music"
            android:background="@drawable/widget_cover_background" android:contentDescription="@null" />
        <LinearLayout android:id="@+id/widget_open" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical"
            android:contentDescription="@string/widget_open">
            <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/widget_empty_title" android:textColor="#FFFFFF" android:textSize="14sp"
                android:fontFamily="@font/manrope_semibold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/widget_empty_artist" android:textColor="#BDBDBD" android:textSize="12sp"
                android:fontFamily="@font/manrope_regular" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <ImageButton android:id="@+id/widget_refresh" android:layout_width="48dp" android:layout_height="48dp"
            android:padding="10dp" android:background="@android:color/transparent" android:src="@drawable/widget_refresh"
            android:contentDescription="@string/widget_refresh" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
        <TextView android:id="@+id/widget_device" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="TROIT" android:textColor="#9E9E9E" android:textSize="10sp"
            android:fontFamily="@font/manrope_regular" android:maxLines="2" android:ellipsize="end" />
        <ImageButton android:id="@+id/widget_previous" android:layout_width="48dp" android:layout_height="48dp"
            android:padding="12dp" android:background="@android:color/transparent" android:src="@drawable/widget_previous"
            android:contentDescription="@string/widget_previous" />
        <ImageButton android:id="@+id/widget_toggle" android:layout_width="48dp" android:layout_height="48dp"
            android:padding="10dp" android:background="@drawable/widget_play_background" android:src="@drawable/widget_play"
            android:contentDescription="@string/widget_play" />
        <ImageButton android:id="@+id/widget_next" android:layout_width="48dp" android:layout_height="48dp"
            android:padding="12dp" android:background="@android:color/transparent" android:src="@drawable/widget_next"
            android:contentDescription="@string/widget_next" />
    </LinearLayout>
</LinearLayout>
